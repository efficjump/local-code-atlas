# Local engine
ATLAS_PORT=4317
# Browser origins allowed to call the local engine.
# ATLAS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional comma-separated roots that the engine is allowed to analyze.
# ATLAS_ALLOWED_ROOTS=/absolute/path/to/projects,/workspace

# Optional chat-completions model adapter. The UI discloses the validated
# endpoint origin and every bounded evidence category before explicit opt-in.
# Non-loopback endpoints must use HTTPS, and redirects are rejected.
# ATLAS_LLM_BASE_URL=https://your-provider.example/v1
# ATLAS_LLM_API_KEY=
# ATLAS_LLM_MODEL=

# Browser client override when the engine is hosted on a different local port.
NEXT_PUBLIC_ATLAS_API_URL=http://127.0.0.1:4317
# Optional URL used by `pnpm launch` when opening the local workbench.
# ATLAS_WEB_URL=http://localhost:3000/

# Use polling when native filesystem events are unavailable in a dev environment.
# ATLAS_WATCH_POLLING=false

# Optional OSV advisory lookup. The UI asks for explicit consent before package
# names and exact versions are sent. These values only adjust lookup budgets.
# ATLAS_OSV_MAX_PACKAGES=200
# ATLAS_OSV_MAX_ADVISORIES=40
# Overall OSV batch and advisory-detail deadline (default 10000, capped at 120000 ms).
# ATLAS_OSV_TIMEOUT_MS=10000
